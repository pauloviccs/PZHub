{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PZHub",
  "version": "2.2.9",
  "identifier": "com.viccs.pzhub",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PZHub - Tactical Live Radar & Modpack Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "pip_player",
        "title": "VICCS TV // Transmissão Ao Vivo",
        "url": "pip.html",
        "width": 460,
        "height": 290,
        "minWidth": 260,
        "minHeight": 170,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
